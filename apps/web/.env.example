# Base URL of the API. Leave as "/api" in development (Vite proxies to the API)
# and set it to the full API URL (e.g. https://api.meetingreview.example.ac.uk/api) for production builds.
VITE_API_BASE_URL=/api
VITE_APP_NAME=Meeting Review
VITE_COLLEGE_NAME=South London College
# Logo shown in the sidebar and on the sign-in page (file in apps/web/public or a full URL). Leave empty for none.
VITE_LOGO_URL=/slc-logo.png
