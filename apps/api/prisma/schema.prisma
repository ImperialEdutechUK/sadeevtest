generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TUTOR
  ACADEMIC_ADMIN
  ACADEMIC_MANAGER
  HR
  DIRECTOR
  SYSTEM_ADMIN
}

enum MeetingType {
  INDUCTION
  PROGRESS_REVIEW
  ONE_TO_ONE
  EXIT_INTERVIEW
  OTHER
}

enum MeetingStatus {
  DRAFT
  QUEUED
  TRANSCRIBING
  EXTRACTING
  ANALYSING
  READY
  FAILED
}

enum FileKind {
  RECORDING
  TRANSCRIPT
  LEARNER_BOOKLET
  PRESENTATION
  OTHER
}

enum FileStatus {
  PENDING
  UPLOADED
  PROCESSED
  FAILED
  DELETED
}

enum TranscriptSource {
  AWS_TRANSCRIBE
  UPLOADED
  MOCK
}

enum AnalysisStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum KpiMetric {
  AVERAGE_SCORE
  MEETINGS_REVIEWED
  MANDATORY_COVERAGE
  LEARNER_TALK_SHARE
}

enum KpiComparison {
  AT_LEAST
  AT_MOST
}

enum AppraisalStatus {
  DRAFT
  GENERATED
  SHARED
  LOCKED
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  users     User[]
  kpis      Kpi[]
  competitions Competition[]
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String?
  firstName          String
  lastName           String
  role               Role      @default(TUTOR)
  jobTitle           String?
  bio                String?
  avatarUrl          String?
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  emailNotifications Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastLoginAt        DateTime?

  refreshTokens      RefreshToken[]
  invitationsSent    Invitation[]   @relation("InvitedBy")
  meetingsAsTutor    Meeting[]      @relation("MeetingTutor")
  meetingsCreated    Meeting[]      @relation("MeetingCreator")
  comments           Comment[]
  moderations        Moderation[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  rubricsCreated     Rubric[]
  kpisCreated        Kpi[]
  kpisTargeted       Kpi[]          @relation("KpiUser")
  competitionsCreated Competition[]
  competitionEntries CompetitionParticipant[]
  appraisalsAsTutor  Appraisal[]    @relation("AppraisalTutor")
  appraisalsCreated  Appraisal[]    @relation("AppraisalCreator")

  @@index([departmentId])
  @@index([role])
}

model Invitation {
  id           String    @id @default(cuid())
  email        String
  firstName    String
  lastName     String
  role         Role
  departmentId String?
  jobTitle     String?
  tokenHash    String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  invitedById  String
  invitedBy    User      @relation("InvitedBy", fields: [invitedById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Rubric {
  id          String      @id @default(cuid())
  name        String
  description String      @default("")
  meetingType MeetingType @default(INDUCTION)
  version     Int         @default(1)
  isPreset    Boolean     @default(false)
  isActive    Boolean     @default(true)
  isDefault   Boolean     @default(false)
  gradeBands  Json
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  categories  RubricCategory[]
  criteria    Criterion[]
  meetings    Meeting[]
  analyses    Analysis[]
  competitions Competition[]

  @@index([meetingType, isActive])
}

model RubricCategory {
  id          String     @id @default(cuid())
  rubricId    String
  rubric      Rubric     @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  name        String
  description String     @default("")
  order       Int        @default(0)
  criteria    Criterion[]

  @@index([rubricId])
}

model Criterion {
  id            String         @id @default(cuid())
  rubricId      String
  rubric        Rubric         @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  categoryId    String
  category      RubricCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  code          String
  title         String
  description   String         @default("")
  weight        Float          @default(1)
  isMandatory   Boolean        @default(false)
  descriptors   Json
  frameworkRefs Json
  order         Int            @default(0)
  isArchived    Boolean        @default(false)

  results       CriterionResult[]

  @@unique([rubricId, code])
  @@index([categoryId])
}

model Meeting {
  id               String        @id @default(cuid())
  title            String
  meetingType      MeetingType   @default(INDUCTION)
  status           MeetingStatus @default(DRAFT)
  tutorId          String
  tutor            User          @relation("MeetingTutor", fields: [tutorId], references: [id])
  createdById      String
  createdBy        User          @relation("MeetingCreator", fields: [createdById], references: [id])
  learnerReference String
  learnerFirstName String?
  programme        String?
  meetingDate      DateTime
  durationSeconds  Int?
  rubricId         String
  rubric           Rubric        @relation(fields: [rubricId], references: [id])
  notes            String?
  failureReason    String?
  processingLog    Json          @default("[]")
  submittedAt      DateTime?
  completedAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  files            MeetingFile[]
  transcript       Transcript?
  analyses         Analysis[]
  comments         Comment[]

  @@index([tutorId, meetingDate])
  @@index([status])
  @@index([rubricId])
  @@index([deletedAt])
}

model MeetingFile {
  id             String     @id @default(cuid())
  meetingId      String
  meeting        Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  kind           FileKind
  fileName       String
  mimeType       String
  sizeBytes      BigInt
  storageKey     String
  status         FileStatus @default(PENDING)
  extractedText  String?
  extractedChars Int?
  error          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([meetingId, kind])
}

model Transcript {
  id          String           @id @default(cuid())
  meetingId   String           @unique
  meeting     Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  source      TranscriptSource
  language    String?
  segments    Json
  speakerMap  Json
  speakerMapSource String      @default("auto")
  wordCount   Int              @default(0)
  jobName     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Analysis {
  id                     String         @id @default(cuid())
  meetingId              String
  meeting                Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  rubricId               String
  rubric                 Rubric         @relation(fields: [rubricId], references: [id])
  rubricVersion          Int
  status                 AnalysisStatus @default(PENDING)
  isCurrent              Boolean        @default(true)
  provider               String?
  model                  String?
  promptVersion          String?
  overallScore           Float?
  moderatedOverallScore  Float?
  grade                  String?
  mandatoryCoverage      Float?
  summary                String?
  learnerExperience      String?
  strengths              Json           @default("[]")
  improvements           Json           @default("[]")
  actionPlan             Json           @default("[]")
  risks                  Json           @default("[]")
  materialsCoverage      Json           @default("[]")
  metrics                Json?
  scoreBreakdown         Json?
  confidence             Confidence?
  confidenceReason       String?
  inputsUsed             Json           @default("[]")
  tokenUsage             Json?
  rawOutput              Json?
  error                  String?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  criteria               CriterionResult[]
  moderations            Moderation[]

  @@index([meetingId, isCurrent])
  @@index([status])
}

model CriterionResult {
  id             String    @id @default(cuid())
  analysisId     String
  analysis       Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  criterionId    String
  criterion      Criterion @relation(fields: [criterionId], references: [id])
  score          Int?
  notApplicable  Boolean   @default(false)
  rationale      String    @default("")
  evidence       Json      @default("[]")
  suggestion     String?
  moderatedScore Int?
  moderationNote String?

  @@unique([analysisId, criterionId])
}

model Moderation {
  id               String   @id @default(cuid())
  analysisId       String
  analysis         Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  moderatorId      String
  moderator        User     @relation(fields: [moderatorId], references: [id])
  originalOverall  Float?
  moderatedOverall Float?
  note             String
  changes          Json     @default("[]")
  createdAt        DateTime @default(now())

  @@index([analysisId])
}

model Comment {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([meetingId])
}

model Kpi {
  id           String        @id @default(cuid())
  name         String
  description  String?
  metric       KpiMetric
  target       Float
  comparison   KpiComparison @default(AT_LEAST)
  periodStart  DateTime
  periodEnd    DateTime
  departmentId String?
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?         @relation("KpiUser", fields: [userId], references: [id], onDelete: Cascade)
  isActive     Boolean       @default(true)
  createdById  String
  createdBy    User          @relation(fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Competition {
  id           String     @id @default(cuid())
  name         String
  description  String     @default("")
  metric       KpiMetric  @default(AVERAGE_SCORE)
  rubricId     String?
  rubric       Rubric?    @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  startDate    DateTime
  endDate      DateTime
  minMeetings  Int        @default(3)
  prize        String?
  autoEnrol    Boolean    @default(false)
  createdById  String
  createdBy    User       @relation(fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  participants CompetitionParticipant[]
}

model CompetitionParticipant {
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt      DateTime    @default(now())

  @@id([competitionId, userId])
}

model Appraisal {
  id           String          @id @default(cuid())
  title        String
  tutorId      String
  tutor        User            @relation("AppraisalTutor", fields: [tutorId], references: [id])
  createdById  String
  createdBy    User            @relation("AppraisalCreator", fields: [createdById], references: [id])
  periodStart  DateTime
  periodEnd    DateTime
  status       AppraisalStatus @default(DRAFT)
  managerNotes String?
  tutorComment String?
  stats        Json?
  narrative    Json?
  model        String?
  generatedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([tutorId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
