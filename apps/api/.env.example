# ---------------------------------------------------------------------------
# Meeting Review API - environment configuration
# Copy to .env for local development. In AWS these are injected from
# Secrets Manager / SSM by the ECS task definition (see infra/terraform).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Public URL of the web app (used for CORS and links in emails/notifications)
WEB_ORIGIN=http://localhost:5173
# Public URL of this API (used to build local upload URLs in dev)
API_PUBLIC_URL=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meeting_review

# Secrets - generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-to-another-long-random-string
# Access token lifetime (minutes) and refresh token lifetime (days)
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# File storage: "local" (dev - files saved under apps/api/storage) or "s3"
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=eu-west-2
# Optional: S3-compatible endpoint (MinIO) for local development
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# AWS credentials are read from the standard chain (env vars, profile, or the ECS task role).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Transcription: "aws" (Amazon Transcribe, requires STORAGE_PROVIDER=s3) or "mock" (dev)
TRANSCRIPTION_PROVIDER=mock
TRANSCRIBE_REGION=eu-west-2
TRANSCRIBE_LANGUAGE=en-GB
TRANSCRIBE_MAX_SPEAKERS=4

# Language model: "openrouter" or "mock" (dev - produces a realistic sample report with no API calls)
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any chat model available on OpenRouter. Pick a current, high-quality model.
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Optional fallback model if the primary is unavailable
OPENROUTER_FALLBACK_MODEL=openai/gpt-4.1
LLM_TIMEOUT_MS=180000

# Email: "ses" (Amazon SES) or "none"
EMAIL_PROVIDER=none
SES_REGION=eu-west-2
EMAIL_FROM="Meeting Review <no-reply@example.ac.uk>"

# First admin account created by `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@example.ac.uk
SEED_ADMIN_PASSWORD=ChangeMe-2026!
# Set to "true" to also create demo tutors, meetings and reports (recommended for evaluation)
SEED_DEMO_DATA=true

# Run background jobs inside the API process (true) or in a separate worker (false, run `pnpm worker`)
RUN_WORKER_IN_API=true
