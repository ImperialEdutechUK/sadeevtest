# Terraform provider lock files are generated by `terraform init`; the hashes are
# platform-specific, so each operator generates their own (run
# `terraform providers lock -platform=linux_amd64 -platform=darwin_arm64` and
# remove this rule if you want to pin them).
.terraform.lock.hcl
