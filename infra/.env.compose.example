# ---------------------------------------------------------------------------
# Compose-level settings for the local stack (infra/docker-compose.yml).
# Copy to infra/.env.compose - that file is git-ignored and is injected into the
# `api` container via env_file. Values fixed in docker-compose.yml (database,
# MinIO, providers that must be mocked locally) cannot be overridden here.
# ---------------------------------------------------------------------------

LOG_LEVEL=info

# Language model: "mock" needs no network and produces a realistic sample report.
# Switch to "openrouter" and paste your key to run real analyses locally.
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_FALLBACK_MODEL=openai/gpt-4.1

# First admin account created by:  docker compose -f infra/docker-compose.yml exec api node dist/seed/seed.js
SEED_ADMIN_EMAIL=admin@example.ac.uk
SEED_ADMIN_PASSWORD=ChangeMe-2026!
SEED_DEMO_DATA=true

# MinIO credentials are fixed in docker-compose.yml (minioadmin / minioadmin). To change them,
# export MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in your shell before running docker compose.
